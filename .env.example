# ---------------------------------------------------------------
# Copy this file to .env and fill in your own values.
#   cp .env.example .env
# .env is git-ignored, so your real passwords never get committed.
# (`neon deploy` / `neon env pull` writes these into .env.local for you.)
# On Render, add the same names under Service > Environment.
# ---------------------------------------------------------------

# Neon > your project > Connect. Paste the strings exactly as Neon shows them.
# Pooled connection (host contains "-pooler") - used by the running app
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Direct connection (same, but WITHOUT "-pooler") - used to create tables and for the one-time import
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-example-123456.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Local PostgreSQL instead of Neon? Use a JDBC URL plus username/password:
# DATABASE_URL=jdbc:postgresql://localhost:5432/student_registration
# DB_USERNAME=postgres
# DB_PASSWORD=change-me

# Websites allowed to call the backend from the browser (comma separated)
ALLOWED_ORIGINS=https://abdullah-alhar.github.io

# Optional tuning (defaults shown)
# DB_POOL_SIZE=5
# TOMCAT_MAX_THREADS=30
