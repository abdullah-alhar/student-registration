# ---------- Secrets (NEVER commit these) ----------
.env
.env.*
!.env.example

# ---------- Neon CLI ----------
.neon
# The Neon CLI adds these Node.js files; this Java app doesn't need them, and
# they make hosts like SnapDeploy think the repo is a Node.js project.
/package.json
/package-lock.json
/neon.ts
node_modules/

# ---------- Claude Code (local AI-assistant skills, not part of the app) ----------
.claude/
skills-lock.json

# ---------- Old .txt data and uploaded files (contain real data / passwords) ----------
legacy-data/
uploads/
src/main/resources/data/

# ---------- Build output ----------
target/
*.class
*.jar
*.log

# ---------- IDE / OS ----------
.idea/
*.iml
.vscode/
.DS_Store
**/.DS_Store
